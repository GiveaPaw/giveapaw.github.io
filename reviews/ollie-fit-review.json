    {
      "id": "ollie-a-tighter-fit",
      "kind": "compare",
      "title": "A · Tighter fit: shrink the scan 2 to 5%",
      "context": "We built the socket on the raw scan and did not account for Ollie's fur.",
      "problem": "The socket was generated directly on the scan, fur included, so it may sit loose on his body and rotate.",
      "proposal": "Shrink the scan by 2 to 5% before generating the socket so it grips him more tightly. Drag the bar under the right-hand view to see each amount against his real size.",
      "ask": "Is a loose fit the likely reason the leg does not track? How much would you take off for a coat like his?",
      "current": {
        "kind": "assembly",
        "caption": "socket on the raw scan",
        "layers": [
          {
            "key": "animal",
            "label": "Solid animal",
            "file": "ollie-solid-animal.glb",
            "color": "#496b94",
            "opacity": 0.38
          },
          {
            "key": "socket",
            "label": "Socket",
            "file": "ollie-socket.glb",
            "color": "#b9c2cc",
            "opacity": 1
          }
        ]
      },
      "proposed": {
        "kind": "sweep",
        "caption": "preview: current socket scaled down",
        "param": "Scan shrink",
        "unit": "%",
        "values": [
          2,
          3,
          4,
          5
        ],
        "defaultValue": 3,
        "source": "ollie-socket.glb",
        "color": "#e0a100",
        "animal": {
          "file": "ollie-solid-animal.glb",
          "label": "Solid animal",
          "color": "#496b94",
          "opacity": 0.38,
          "visible": true
        }
      }
    },
    {
      "id": "ollie-b-third-strap",
      "kind": "stage",
      "title": "B · Add a third strap",
      "context": "The socket is held on with two velcro straps.",
      "problem": "With only two straps the socket can shift and rotate on his chest as he moves.",
      "proposal": "Add a third strap so the socket is held at three points and stays put.",
      "ask": "Where would you place a third strap? Would you change the strap material? We used velcro.",
