    {
      "id": "ollie-f-denser-lattice",
      "kind": "stage",
      "title": "F · Denser lattice",
      "context": "The vet asked for ventilation, so we kept the lattice open.",
      "problem": "The lattice may be too sparse to hold its shape under load.",
